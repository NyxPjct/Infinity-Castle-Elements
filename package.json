{
  "name": "infinity-castle-elements",
  "version": "0.0.11",
  "private": true,
  "description": "Infinity Castle Elements \u2014 INSANITY 0.0.11. Authored solo rooms, elemental routes, mastery, best-time ghosts, branching memories and New Game+.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:levels": "node tools/audit-levels.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "start:multiplayer": "MULTIPLAYER_ONLY=1 node server.js",
    "test:chaos": "node tools/test-chaos-multiplayer.js",
    "test:i18n": "node tools/test-i18n.js",
    "test:visuals": "node tools/test-visuals.js",
    "test:features": "node tools/test-features.js",
    "test:reconnect": "node tools/test-reconnect.js",
    "test:browser": "node tools/test-browser.js",
    "test:updates": "node tools/test-updates.js",
    "test:mastery": "node tools/test-mastery.js",
    "test:mastery-online": "node tools/test-mastery-online.js",
    "test:mastery-browser": "node tools/test-mastery-browser.js",
    "mobile:add:android": "npx cap add android",
    "mobile:sync": "npx cap sync android",
    "mobile:android": "npx cap open android",
    "test:expedition": "node tools/test-expedition.js",
    "test:expedition-browser": "node tools/test-expedition-browser.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "socket.io-client": "^4.8.1",
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@capacitor/core": "6.2.1"
  },
  "build": {
    "appId": "com.nyxprojectr.infinitycastleelements",
    "productName": "Infinity Castle Elements",
    "copyright": "Copyright \u00a9 2026 NYX PROJECT R",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "public/**/*",
      "desktop/**/*",
      "server.js",
      "package.json",
      "README.md",
      "COMO_JOGAR.txt",
      "build/icon.ico",
      "backend/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infinity Castle Elements",
      "runAfterFinish": true,
      "artifactName": "Infinity-Castle-Elements-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Infinity-Castle-Elements-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "backend/**/*",
      "public/**/*"
    ]
  }
}
